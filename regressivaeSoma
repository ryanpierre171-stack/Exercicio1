import java.util.Scanner;

public class Ex10 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int soma = 0;

        for (int i = n; i >= 1; i--) {
            System.out.print(i + " ");
            soma += i;
        }

        System.out.println();
        System.out.println("Soma = " + soma);

        sc.close();
    }
}
